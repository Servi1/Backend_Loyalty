// ─── Servio Tenant Database — Prisma Schema ──────────────
 
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-tenant"
}
 
// In the tenant schema, the url is provided programmatically
datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}
 
// ─── Enums ───────────────────────────────────────────
 
enum Role {
  BRAND_MANAGER
  BRANCH_MANAGER
  CASHIER
  WAITER
  KITCHEN
  CUSTOM
}
 
enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
 
enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  DELIVER_TO_CAR
  SCHEDULED
}
 
// ─── Users ───────────────────────────────────────────
 
model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  password  String?  // hashed — null for OTP-only customers
  name      String?
  role      Role     @default(CASHIER)
  customRole String?
  avatarUrl String?
  pinCode   String?
 
  // Relations
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
 
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  @@index([phone])
  @@index([email])
}
 
// ─── OTP (for phone-based auth) ─────────────────────
 
model Otp {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}
 
// ─── Branches (Individual Locations) ─────────────────
 
model Branch {
  id        String  @id @default(uuid())
  name      String
  address   String?
  city      String?
  phone     String?
  lat       Float?
  lng       Float?
  isOpen    Boolean @default(true)
  ordersEnabled Boolean @default(true)
  hours     String? @default("10am - 11pm")
  rating    Float?  @default(4.8)
  imageUrl  String?
  tables    Table[]
  orders    Order[]
  staff     User[]
  inventory InventoryItem[]
  posDevices PosDevice[]
  qrCashiers qrCashier[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
// ─── Tables ──────────────────────────────────────────
 
model Table {
  id       String  @id @default(uuid())
  label    String  // e.g. "Table 4"
  seats    Int     @default(4)
  qrCode   String? @unique
  isActive Boolean @default(true)
  zone     String? @default("Main")
 
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
 
  orders   Order[]
 
  createdAt DateTime @default(now())
}
 
// ─── Menu ────────────────────────────────────────────
 
model MenuCategory {
  id    String @id @default(uuid())
  name  String
  order Int    @default(0)
 
  items MenuItem[]
}
 
model MenuItem {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  isAvailable Boolean @default(true)
  isChefPick  Boolean @default(false)
  rating      Float?  @default(4.8)
 
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])
 
  orderItems OrderItem[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
// ─── Orders ──────────────────────────────────────────
 
model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  type        OrderType   @default(DINE_IN)
  total       Float       @default(0)
  notes       String?
  feeRate     Float       @default(0.0)
  // Relations
  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
  customerId String? // Global customer ID from main database
  customerPhone String?
  branchId   String
  branch   Branch @relation(fields: [branchId], references: [id])
  tableId  String?
  table    Table? @relation(fields: [tableId], references: [id])
  posUnit  String?
  items    OrderItem[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model OrderItem {
  id       String @id @default(uuid())
  quantity Int    @default(1)
  price    Float
  notes    String?
 
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

// ─── Inventory (Branch-level) ────────────────────────
 
model InventoryItem {
  id       String @id @default(uuid())
  name     String
  quantity Int    @default(0)
  unit     String @default("pcs")
 
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
 
  updatedAt DateTime @updatedAt
}

// ─── POS Devices ──────────────────────────────────────

model PosDevice {
  id        String   @id @default(uuid())
  name      String   // e.g., "POS 1", "POS 2", etc.
  deviceKey String   @unique // 8-digit random number
  isActive  Boolean  @default(true)

  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

