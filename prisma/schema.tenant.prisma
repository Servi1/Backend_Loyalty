// ─── Servio Tenant Database — Prisma Schema ──────────────
 
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-tenant"
}
 
// In the tenant schema, the url is provided programmatically
datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}
 
// ─── Enums ───────────────────────────────────────────
 
enum Role {
  BRAND_MANAGER
  BRANCH_MANAGER
  CASHIER
  WAITER
  KITCHEN
  CUSTOM
  WAREHOUSE_MANAGER
}
 
enum OrderStatus {
  HALTED
  PENDING
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  REFUNDED
}
 
enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  DELIVER_TO_CAR
  SCHEDULED
}
 
// ─── Users ───────────────────────────────────────────
 
model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  password  String?  // hashed — null for OTP-only customers
  name      String?
  role      Role     @default(CASHIER)
  customRole String?
  avatarUrl String?
  pinCode   String?
  isActive  Boolean  @default(true)
 
  // Relations
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation("WarehouseStaff", fields: [warehouseId], references: [id], onDelete: SetNull)
 
  orders    Order[]
  openedSessions CashDrawerSession[] @relation("OpenedSessions")
  closedSessions CashDrawerSession[] @relation("ClosedSessions")
  schedules StaffSchedule[]
  specialties MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([phone])
  @@index([email])
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  level       Int      @default(50)
  description String?
  color       String   @default("Orange")
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
 
// ─── Branches (Individual Locations) ─────────────────
 
model Branch {
  id        String  @id @default(uuid())
  name      String
  address   String?
  city      String?
  phone     String?
  reference             String?
  email                 String?
  bio                   String?
  country               String?
  addressLine1          String?
  addressLine2          String?
  district              String?
  postalCode            String?
  buildingNumber        String?
  shortAddress          String?
  coordinates           String?
  timezone              String?   @default("Asia/Riyadh")
  openingTime           String?   @default("08:00 AM")
  closingTime           String?   @default("11:00 PM")
  license               String?
  vatId                 String?
  receiptLogoUrl        String?
  receiptWebsite        String?
  receiptAdditionalText String?
  lat       Float?
  lng       Float?
  isOpen    Boolean @default(true)
  ordersEnabled Boolean @default(true)
  menuEnabled   Boolean @default(true)
  tablesEnabled Boolean @default(true)
  staffEnabled  Boolean @default(true)
  qrEnabled     Boolean @default(true)
  posEnabled    Boolean @default(true)
  kdsEnabled    Boolean @default(false)
  cdsEnabled    Boolean @default(false)
  appServiEnabled Boolean @default(true)
  tablesSubscribedAt DateTime? @default(now())
  posSubscribedAt    DateTime? @default(now())
  qrSubscribedAt     DateTime? @default(now())
  kdsSubscribedAt    DateTime?
  cdsSubscribedAt    DateTime?
  appServiSubscribedAt DateTime? @default(now())
  hours     String? @default("10am - 11pm")
  rating    Float?  @default(4.8)
  imageUrl  String?
  menuBannerUrl String?
  tables    Table[]
  orders    Order[]
  staff     User[]
  inventory InventoryItem[]
  posDevices PosDevice[]
  kdsDevices KdsDevice[]
  cashDrawerSessions CashDrawerSession[]
  qrCashiers QrCashier[]
  productRequests ProductRequest[]
  locationGroupId     String?
  locationGroup       LocationGroup?     @relation(fields: [locationGroupId], references: [id])
  customPaymentTypes CustomPaymentType[]
  customOrderTypes   CustomOrderType[]

  // ZATCA Phase 2 Integration Fields
  zatcaEnabled       Boolean   @default(false)
  zatcaEnvironment   String?   @default("sandbox") // sandbox | simulation | production
  zatcaVatNumber     String?
  zatcaCrNumber      String?
  zatcaCsidSecret    String?
  zatcaPrivateKey    String?
  zatcaCertificate   String?
  zatcaStatus        String?   @default("UNREGISTERED") // UNREGISTERED | COMPLIANCE_PASSED | PRODUCTION_ACTIVE
  zatcaLastSync      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QrCashier {
  id        String   @id @default(uuid())
  name      String   // e.g. "Cashier 1"
  qrCode    String?  @unique
  isActive  Boolean  @default(true)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
// ─── Tables ──────────────────────────────────────────
 
model Table {
  id       String  @id @default(uuid())
  label    String  // e.g. "Table 4"
  seats    Int     @default(4)
  qrCode   String? @unique
  isActive Boolean @default(true)
  zone     String? @default("Main")
 
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
 
  orders   Order[]
 
  expiresAt DateTime?
  createdAt DateTime @default(now())
}
 
// ─── Menu ────────────────────────────────────────────
 
model MenuCategory {
  id    String @id @default(uuid())
  name  String
  order Int    @default(0)
 
  items MenuItem[]
}
 
model MenuItem {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  isAvailable Boolean @default(true)
  isChefPick  Boolean @default(false)
  rating      Float?  @default(4.8)
  modifiers   Json?   @default("[]")
  spinEnabled    Boolean @default(false)
  spinDailyLimit Int?    @default(0)
  spinTotalLimit Int?    @default(0)
  prepTime       Int?    @default(15)
 
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])
 
  orderItems OrderItem[]
  specialists User[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffSchedule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String   // e.g. "09:00"
  endTime   String   // e.g. "17:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayOfWeek, startTime, endTime])
}
 
// ─── Orders ──────────────────────────────────────────
 
model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  type        OrderType   @default(DINE_IN)
  total       Float       @default(0)
  notes       String?
  feeRate     Float       @default(0.0)
  // Relations
  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
  customerId String? // Global customer ID from main database
  customerPhone String?
  branchId   String
  branch   Branch @relation(fields: [branchId], references: [id])
  tableId  String?
  table    Table? @relation(fields: [tableId], references: [id])
  customOrderTypeId String?
  customOrderType   CustomOrderType? @relation(fields: [customOrderTypeId], references: [id])
  posUnit       String?
  source        String      @default("pos") // pos | app | qr_cashier | qr_table
  qrCashierId   String?
  qrCashier     QrCashier?  @relation(fields: [qrCashierId], references: [id])
  paymentMethod String?  @default("cash") // cash | card | apple_pay | google_pay | split | points
  pointsRedeemed Int?   // points deducted from wallet (only when paymentMethod = "points")
  items    OrderItem[]
 
  staffId          String?
  staffName        String?
  selectedSlot     String?
  selectedSlotDate String?
  slotDetails      Json?
  rating           Int?
  comment          String?

  // ZATCA Phase 2 E-Invoicing Tracking Fields
  zatcaXml        String?
  zatcaQrCode     String?
  zatcaHash       String?
  zatcaIcv        Int?
  zatcaPih        String?
  zatcaReported   Boolean   @default(false)
  zatcaReportedAt DateTime?
  zatcaStatus     String?   @default("PENDING") // PENDING | ACCEPT | REJECT
  zatcaError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model OrderItem {
  id                String  @id @default(uuid())
  quantity          Int     @default(1)
  price             Float
  notes             String?
  selectedModifiers Json?   @default("[]")
  
  staffId          String?
  staffName        String?
  selectedSlot     String?
  selectedSlotDate String?
 
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

// ─── Inventory (Branch-level) ────────────────────────
 
model InventoryItem {
  id       String @id @default(uuid())
  name     String
  quantity Int    @default(0)
  unit     String @default("pcs")
 
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
 
  updatedAt DateTime @updatedAt
}

// ─── POS Devices ──────────────────────────────────────

model PosDevice {
  id        String   @id @default(uuid())
  name      String   // e.g., "POS 1", "POS 2", etc.
  deviceKey String   @unique // 8-digit random number
  isActive  Boolean  @default(true)

  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
 
  // Per-POS Device ZATCA Phase 2 Integration Fields
  zatcaEnabled       Boolean   @default(false)
  zatcaEnvironment   String?   @default("sandbox") // sandbox | production
  zatcaCsidSecret    String?
  zatcaPrivateKey    String?
  zatcaCertificate   String?
  zatcaOtp           String?
  zatcaStatus        String?   @default("UNREGISTERED") // UNREGISTERED | COMPLIANCE_PASSED | PRODUCTION_ACTIVE
  zatcaLastSync      DateTime?

  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KdsDevice {
  id        String   @id @default(uuid())
  name      String   // e.g., "KDS 1", "KDS 2", etc.
  deviceKey String   @unique // 8-digit random number
  isActive  Boolean  @default(true)

  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
 
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discount {
  id                 String   @id @default(uuid())
  nameEn             String
  nameAr             String?
  type               String   // "percentage" | "amount"
  value              Float
  maxAmount          Float?
  applyInstantly     Boolean  @default(true)
  appliedOn          String   @default("orders") // "orders" | "items"
  locations          Json     // Array of branch IDs: ["uuid-1", "uuid-2"]
  hasDateRange       Boolean  @default(false)
  startDate          DateTime?
  endDate            DateTime?
  hasWeeklySchedule  Boolean  @default(false)
  weeklySchedule     Json?    // Array of day schedules
  isActive           Boolean  @default(true)
  itemsList          Json?    // Array of selected items
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Coupon {
  id                 String    @id @default(uuid())
  title              String
  code               String    @unique
  quantity           Int       @default(0) // 0 means unlimited
  usedCount          Int       @default(0)
  locations          Json      // Array of branch IDs: ["uuid-1", "uuid-2"]
  type               String    // "items" | "orders"
  
  // If type == "items"
  itemsDeductionType String?   // "fixed" (Fixed Items)
  itemsList          Json?     // Array of items: [{"itemId": "x", "name": "Black Tea", "quantity": 2}]

  // If type == "orders"
  discountType       String?   // "percentage" | "amount"
  discountValue      Float?
  priceCap           Float?    // Price Cap for percentage
  minOrderAmount     Float?    @default(0)

  startDate          DateTime
  endDate            DateTime
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ─── Custom Payment Types ────────────────────────────

model CustomPaymentType {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String?
  isActive  Boolean  @default(true)
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Location Groups ─────────────────────────────────

model LocationGroup {
  id        String   @id @default(uuid())
  name      String
  locations Json     // Array of branch IDs: ["uuid-1", "uuid-2"]
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Custom Order Types ──────────────────────────────

model CustomOrderType {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  branches    Branch[]
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Cash Drawer Sessions ─────────────────────────────

model CashDrawerSession {
  id                    String    @id @default(uuid())
  branchId              String
  branch                Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedById            String
  openedBy              User      @relation("OpenedSessions", fields: [openedById], references: [id])
  closedById            String?
  closedBy              User?     @relation("ClosedSessions", fields: [closedById], references: [id])
  openedAt              DateTime  @default(now())
  closedAt              DateTime?
  openingBalance        Float
  expectedEndingBalance Float?
  actualEndingBalance   Float?
  discrepancy           Float?
  expectedSales         Float?    @default(0.0)
  status                String    @default("OPEN") // OPEN | CLOSED
  cashCounts            Json?     // { hundreds: 0, fifties: 0, ... }
  transactions          Json?     // Array of: { id, type, description, amount, time }
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([branchId])
}

// ─── Warehouses and Inventory Management ───────────────

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productRequests ProductRequest[]
  staff           User[]           @relation("WarehouseStaff")
}

model ProductRequest {
  id          String   @id @default(uuid())
  type        String   // "RESTOCK" or "NEW_PRODUCT"
  details     String   // items & quantities or specifications
  reason      String?  // notes / reason
  status      String   @default("PENDING") // PENDING, APPROVED, FULFILLED, REJECTED
  
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
