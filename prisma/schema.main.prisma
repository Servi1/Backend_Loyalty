// ─── Servio Main Database — Prisma Schema ────────────────
 
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-main"
}
 
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
// ─── Enums ───────────────────────────────────────────
 
enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}
 
// ─── Super Admins ────────────────────────────────────
 
model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("super_admin")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
// ─── Tenants (Registry) ──────────────────────────────
 
model Tenant {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  dbUrl            String           // The database connection string for this tenant
  // ─── Visual Settings
  logoUrl          String?
  primaryColor     String?          @default("#6366f1")
  accentColor      String?          @default("#f59e0b")
  fontFamily       String?          @default("Inter")
  layoutStyle      String?          @default("modern")
 
  // ─── Contact Info
  contactEmail     String?
  phone            String?
  website          String?
  address          String?
  city             String?
  country          String?
 
  // ─── Billing & Operations
  timezone         String?
  currency         String?
  billingCycle     String?
  taxId            String?
  notes            String?
  subscriptionTier SubscriptionTier @default(FREE)
  plan             String?          @default("starter")
  subAppServi      Boolean          @default(false)
  subAppBrand      Boolean          @default(false)
  subPos           Boolean          @default(false)
  posQuantity      Int              @default(1)
  qrTableQuantity  Int              @default(10)
  subQrTable       Boolean          @default(false)
  subQrCashier     Boolean          @default(false)

  priceAppServi    Float            @default(29.0)
  cycleAppServi    String           @default("monthly")
  feeAppServi      Float            @default(0.0)
  priceAppBrand    Float            @default(99.0)
  cycleAppBrand    String           @default("monthly")
  feeAppBrand      Float            @default(0.0)
  pricePos         Float            @default(49.0)
  cyclePos         String           @default("monthly")
  feePos           Float            @default(0.0)
  priceQrTable     Float            @default(19.0)
  cycleQrTable     String           @default("monthly")
  feeQrTable       Float            @default(0.0)
  priceQrCashier   Float            @default(9.0)
  cycleQrCashier   String           @default("monthly")
  feeQrCashier     Float            @default(0.0)
  // ─── Feature Flags
  notificationsEnabled Boolean @default(true)
  autoPayouts          Boolean @default(true)
  ordersEnabled        Boolean @default(true)
  loyaltyEnabled       Boolean @default(false)
  loyaltyEarnRate      Float   @default(1.0)
  loyaltyRedeemRate    Float   @default(100.0)
  isActive         Boolean          @default(true)
 
  // Relations
  aggregatedOrders    AggregatedOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model AggregatedOrder {
  id             String   @id // format: tenantId_orderId
  tenantId       String
  orderId        String
  orderNumber    String
  status         String
  type           String
  total          Float
  notes          String?
  customerName   String?
  branchName     String?
  feeRate        Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
 
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
 
  @@index([tenantId])
  @@index([createdAt])
}
 
// ─── Global App Users ────────────────────────────────
model AppUser {
  id             String   @id @default(uuid())
  phone          String   @unique
  email          String?  @unique
  name           String?
  lastName       String?
  gender         String?
  dob            DateTime?
  avatarUrl      String?
  cars           Json?    @default("[]")
  addresses      Json?    @default("[]")
  paymentMethods Json?    @default("[]")
  favoriteBrands Json?    @default("[]")
  // Relations
  orders        Order[]
  wallet        Wallet?
  sentGifts     Gift[]   @relation("SentGifts")
  receivedGifts Gift[]   @relation("ReceivedGifts")
  cart          CartItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([phone])
  @@index([email])
}

model CartItem {
  id          String   @id @default(uuid())
  appUserId   String
  appUser     AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  cartLineId  String   // format: brandId:itemId or brandId:itemId:size:flavor
  brandId     String
  itemId      String
  name        String
  price       Float
  qty         Int      @default(1)
  image       String?
  size        String?
  flavor      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([appUserId, cartLineId])
}
model Order {
  id        String   @id @default(uuid())
  appUserId String
  appUser   AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Global Loyalty Wallets ──────────────────────────
model Wallet {
  id           String              @id @default(uuid())
  points       Int                 @default(0)
  lifetimeEarn Int                 @default(0)
  tier         String?             @default("bronze")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  appUserId    String              @unique
  appUser      AppUser             @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]
}
model WalletTransaction {
  id          String   @id @default(uuid())
  points      Int      // positive = earn, negative = redeem
  description String?
  tenantId    String?  // The tenant brand where this happened
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// ─── Gift Model ──────────────────────────────────────
model Gift {
  id          String   @id @default(uuid())
  senderId    String
  sender      AppUser  @relation("SentGifts", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   AppUser  @relation("ReceivedGifts", fields: [recipientId], references: [id], onDelete: Cascade)
  points      Int
  message     String?
  claimed     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([recipientId])
  @@index([senderId])
}
