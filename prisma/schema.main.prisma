// ─── Servio Main Database — Prisma Schema ────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-main"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ─── Super Admins ────────────────────────────────────

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Tenants (Registry) ──────────────────────────────

model Tenant {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  dbUrl            String           // The database connection string for this tenant
  // ─── Visual Settings
  logoUrl          String?
  primaryColor     String?          @default("#6366f1")
  accentColor      String?          @default("#f59e0b")
  fontFamily       String?          @default("Inter")
  layoutStyle      String?          @default("modern")

  // ─── Contact Info
  contactEmail     String?
  phone            String?
  website          String?
  address          String?
  city             String?
  country          String?

  // ─── Billing & Operations
  timezone         String?
  currency         String?
  billingCycle     String?
  taxId            String?
  notes            String?
  subscriptionTier SubscriptionTier @default(FREE)
  plan             String?          @default("starter")

  // ─── Feature Flags
  notificationsEnabled Boolean @default(true)
  autoPayouts          Boolean @default(true)
  ordersEnabled        Boolean @default(true)
  loyaltyEnabled       Boolean @default(false)
  
  isActive         Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
