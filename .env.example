# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (PostgreSQL) ────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/servio_db?schema=public"

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── Twilio (SMS / OTP - Legacy) ─────────────────────
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─── OurSMS (OTP Provider) ───────────────────────────
OURSMS_API_TOKEN=your_token_here
OURSMS_SENDER_NAME=oursms
OURSMS_ENABLED=true
ALLOW_DEV_OTP_BYPASS=false

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
